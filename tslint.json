{
  "defaultSeverity": "error",
  "extends": [
    "tslint:recommended"
  ],
  "linterOptions": {
    "exclude": [
      "node_modules",
      "./node_modules",
      "./node_modules/*",
      "./node_modules/vuetify/src/util/helpers.ts"
    ]
  },
  "jsRules": {},
  "rules": {
    "member-access": false,
    "no-string-literal": [
      false
    ],
    "interface-name": [
      true,
      "never-prefix"
    ],
    "max-line-length": [
      false
    ],
    "no-console": [
      false,
      "log",
      "error"
    ],
    "no-var-requires": false,
    "quotemark": {
      "options": "single",
      "severity": "off"
    },
    "one-variable-per-declaration": false,
    "curly": [
      true,
      "ignore-same-line"
    ],
    "trailing-comma": [
      true,
      {
        "multiline": "never",
        "singleline": "never"
      }
    ],
    "space-before-function-paren": true,
    "variable-name": false,
    "object-literal-sort-keys": [
      false
    ],
    "semicolon": false,
    "no-shadowed-variable": false,
    "only-arrow-functions": false,
    "ordered-imports": false,
    "typedef-whitespace": [
      false
    ]
  },
  "rulesDirectory": []
}
